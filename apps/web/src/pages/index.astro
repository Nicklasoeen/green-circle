---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import CustomerLogos from '../components/CustomerLogos.astro';
import PhotoStrip from '../components/PhotoStrip.astro';
import Pillars from '../components/Pillars.astro';
import Refrigerants from '../components/Refrigerants.astro';
import Applications from '../components/Applications.astro';
import Case from '../components/Case.astro';
import Process from '../components/Process.astro';
import Contact from '../components/Contact.astro';

const lang = 'nb';
---

<Layout lang={lang}>
  <Nav lang={lang} />
  <Hero lang={lang} />
  <CustomerLogos lang={lang} />
  <PhotoStrip lang={lang} />
  <Pillars lang={lang} />
  <Refrigerants lang={lang} />
  <Applications lang={lang} />
  <Case lang={lang} />
  <Process lang={lang} />
  <Contact lang={lang} />
</Layout>

<script>
  import '../scripts/main.ts';
</script>
