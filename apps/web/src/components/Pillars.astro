---
import type {Lang} from '../i18n';

interface Props {
  lang?: Lang;
}

const {lang = 'nb'} = Astro.props;

const copy = {
  nb: {
    sectionNum: '01 — PRINSIPPER',
    titlePrefix: 'Fire ting kjennetegner',
    titleSuffix: 'hver',
    highlightedTitle: 'Green Circle-maskin.',
    titleEnd: '',
    pillars: [
      {
        title: 'Skreddersydd i Norge',
        body: 'Hver maskin er produsert av dedikerte fagfolk i bransjen — fra våre verksteder til anlegg over hele landet.',
      },
      {
        title: 'Naturlige kuldemedier',
        body: 'Kun medier med lavt globalt oppvarmingspotensial — uten fluorforbindelser og uten PFAS. Propan, isobutan, CO₂ og ammoniakk.',
      },
      {
        title: 'Skreddersydde løsninger',
        body: 'Konstruert for spesifikt formål. Serieproduksjon kan aldri matche en maskin bygget for ditt system.',
      },
      {
        title: 'Enestående COP',
        body: '3–8 enheter varme for hver kWh tilført elektrisk energi. Smart, stabilt, bærekraftig.',
      },
    ],
  },
  en: {
    sectionNum: '01 — PRINCIPLES',
    titlePrefix: 'Four things define',
    titleSuffix: 'every',
    highlightedTitle: 'Green Circle',
    titleEnd: ' unit.',
    pillars: [
      {
        title: 'Handcrafted in Norway',
        body: 'Every unit is built by specialists in the field — from our workshops to facilities across the country.',
      },
      {
        title: 'Natural refrigerants',
        body: 'Only media with low global warming potential — without fluorinated compounds and without PFAS. Propane, isobutane, CO₂ and ammonia.',
      },
      {
        title: 'Bespoke solutions',
        body: 'Engineered for a specific purpose. Series production can never match a machine built for your system.',
      },
      {
        title: 'Outstanding COP',
        body: '3–8 units of heat for every kWh of electrical energy supplied. Smart, stable and sustainable.',
      },
    ],
  },
}[lang];
---

<section id="pillars">
  <div class="section-head reveal">
    <div class="section-num">{copy.sectionNum}</div>
    <h2 class="section-title">
      {copy.titlePrefix}<br />{copy.titleSuffix} <span class="lime">{copy.highlightedTitle}</span>{copy.titleEnd}
    </h2>
  </div>
  <div class="pillars reveal">
    {
      copy.pillars.map((p, i) => (
        <div class="pillar">
          <div class="pillar-num">/{String(i + 1).padStart(2, '0')}</div>
          <h3>{p.title}</h3>
          <p>{p.body}</p>
        </div>
      ))
    }
  </div>
</section>
