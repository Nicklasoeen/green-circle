---
import type {Lang} from '../i18n';

interface Props {
  lang?: Lang;
}

const {lang = 'nb'} = Astro.props;

const copy = {
  nb: {
    sectionNum: '03 — BRUKSOMRÅDER',
    title: 'Femten prosesser.',
    titleLine2: 'En plattform.',
    apps: [
      'Næringsbygg',
      'Svømmehaller',
      'Fjernvarmeanlegg',
      'Fjernkjøleanlegg',
      'Slakteri — kjøtt',
      'Slakteri — fisk',
      'Spekematproduksjon',
      'Landbasert oppdrett',
      'Frukt og grønnsaker',
      'Datasentraler',
      'Biogass',
      'Hydrogenproduksjon',
      'Industrielle prosesser',
      'Legemiddelproduksjon',
      '…og mer',
    ],
  },
  en: {
    sectionNum: '03 — APPLICATIONS',
    title: 'Fifteen processes.',
    titleLine2: 'One platform.',
    apps: [
      'Commercial buildings',
      'Swimming pools',
      'District heating plants',
      'District cooling plants',
      'Slaughterhouses — meat',
      'Slaughterhouses — fish',
      'Cured meat production',
      'Land-based aquaculture',
      'Fruit and vegetables',
      'Data centres',
      'Biogas',
      'Hydrogen production',
      'Industrial processes',
      'Pharmaceutical production',
      '…and more',
    ],
  },
}[lang];

const padCount = (4 - (copy.apps.length % 4)) % 4;
const pads = Array.from({ length: padCount });
---

<section id="applications">
  <div class="section-head reveal">
    <div class="section-num">{copy.sectionNum}</div>
    <h2 class="section-title">{copy.title}<br />{copy.titleLine2}</h2>
  </div>
  <div class="app-grid reveal">
    {
      copy.apps.map((name, i) => (
        <div class="app">
          <div class="app-num">{String(i + 1).padStart(2, '0')}</div>
          <div class="app-name">{name}</div>
          <svg class="app-arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M3 13 13 3M5 3h8v8"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
            />
          </svg>
        </div>
      ))
    }
    {pads.map(() => <div class="app pad" aria-hidden="true" />)}
  </div>
</section>
