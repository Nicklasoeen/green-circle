---
import type {Lang} from '../i18n';

type Refrigerant = {
  id: string;
  code: string;
  name: string;
  tabName: string;
  alt: string;
  desc: string;
  gwpChip: string;
  stats: { label: string; val: string; unit?: string }[];
};

interface Props {
  lang?: Lang;
}

const {lang = 'nb'} = Astro.props;

const copy: Record<Lang, {
  sectionNum: string;
  title: string;
  mutedTitle: string;
  pfas: string;
  tabAria: string;
  refrigerants: Refrigerant[];
}> = {
  nb: {
    sectionNum: '02 — KULDEMEDIER',
    title: 'Velg medium,',
    mutedTitle: 'få riktig verktøy for jobben.',
    pfas:
      'Kuldemediene Green Circle benytter tilhører gruppen naturlige kuldemedier og inneholder ikke fluorforbindelser slik HFK-, HFO- eller syntetiske blandingsmedier gjør. De omfattes derfor ikke av PFAS-problematikken som nå får økt oppmerksomhet i EU og internasjonalt.',
    tabAria: 'Kuldemedier',
    refrigerants: [
      {
        id: 'r290',
        code: 'R290',
        name: 'Propan',
        tabName: 'Propan',
        alt: 'Isvann- og varmepumpeanlegg',
        desc: 'En etter hvert velprøvd løsning for applikasjoner i medium temperaturområde. R290 (propan) egner seg svært godt til isvann- og varmepumpeanlegg, og gir en god balanse mellom kapasitet, energieffektivitet og kompakte aggregatløsninger.',
        gwpChip: 'GWP 3',
        stats: [
          { label: 'Kapasitet', val: '≤ 1000', unit: 'kW' },
          { label: 'Utgående temp.', val: '60', unit: '°C' },
          { label: 'GWP', val: '3' },
        ],
      },
      {
        id: 'r600a',
        code: 'R600a',
        name: 'Isobutan',
        tabName: 'Isobutan',
        alt: 'Høytemperatur varmepumper',
        desc: 'R600a egner seg godt i prosesser med høyere temperaturkrav enn det man vanligvis forbinder med tradisjonelle varmepumpeanlegg, og er et godt valg der det stilles krav til høyere temperaturer i industrielle og termiske prosesser.',
        gwpChip: 'GWP 3',
        stats: [
          { label: 'Kapasitet', val: '≤ 2000', unit: 'kW' },
          { label: 'Utgående temp.', val: '85', unit: '°C' },
          { label: 'GWP', val: '3' },
        ],
      },
      {
        id: 'r744',
        code: 'R744',
        name: 'Karbondioksid',
        tabName: 'CO₂ / karbondioksid',
        alt: 'Varmepumper med høy ytelse og kompakt design',
        desc: 'CO₂ er spesielt godt egnet i applikasjoner der det er behov for høy varmtvannstemperatur samtidig som man har tilgang til en lavtemperatur varmekilde. Dette gjør kuldemediet svært aktuelt for blant annet tappevann, varmegjenvinning og ulike industrielle prosesser.',
        gwpChip: 'GWP 1',
        stats: [
          { label: 'Kapasitet', val: '≤ 1000', unit: 'kW' },
          { label: 'Anvendelse', val: 'Dual', unit: 'bruk' },
          { label: 'GWP', val: '1' },
        ],
      },
      {
        id: 'r717',
        code: 'R717',
        name: 'Ammoniakk',
        tabName: 'NH₃ / ammoniakk',
        alt: 'Industrielle kulde- og varmepumpeanlegg',
        desc: 'Ammoniakk er kuldemediet med noen av de beste termodynamiske egenskapene som finnes, og gir svært høy energieffektivitet i både mellomstore og store anlegg. NH₃ har vært brukt i industrielle kuldeanlegg i over 100 år, og moderne løsninger er utviklet med stort fokus på sikker og stabil drift.',
        gwpChip: 'GWP 0',
        stats: [
          { label: 'Kapasitet', val: '> 300', unit: 'kW' },
          { label: 'Utgående temp.', val: '80', unit: '°C' },
          { label: 'GWP', val: '0' },
        ],
      },
    ],
  },
  en: {
    sectionNum: '02 — REFRIGERANTS',
    title: 'Choose the medium,',
    mutedTitle: 'get the right tool for the job.',
    pfas:
      'The refrigerants used by Green Circle belong to the group of natural refrigerants and do not contain fluorinated compounds like HFC, HFO or synthetic blended media. They are therefore not part of the PFAS issue that is now receiving increased attention in the EU and internationally.',
    tabAria: 'Refrigerants',
    refrigerants: [
      {
        id: 'r290',
        code: 'R290',
        name: 'Propane',
        tabName: 'Propane',
        alt: 'Chilled water and heat pump systems',
        desc: 'The most widely used solution in the Green Circle range. Propane is highly suitable for chilled water and heat pump systems, with a strong balance between capacity, efficiency and footprint.',
        gwpChip: 'GWP 3',
        stats: [
          { label: 'Capacity', val: '≤ 1000', unit: 'kW' },
          { label: 'Outgoing temp.', val: '60', unit: '°C' },
          { label: 'GWP', val: '3' },
        ],
      },
      {
        id: 'r600a',
        code: 'R600a',
        name: 'Isobutane',
        tabName: 'Isobutane',
        alt: 'High-temperature heat pumps',
        desc: 'When the process requires higher temperatures than propane can provide, isobutane takes over. Ideal for district heating, drying processes and industrial heat recovery where 85 °C is required.',
        gwpChip: 'GWP 3',
        stats: [
          { label: 'Capacity', val: '≤ 2000', unit: 'kW' },
          { label: 'Outgoing temp.', val: '85', unit: '°C' },
          { label: 'GWP', val: '3' },
        ],
      },
      {
        id: 'r744',
        code: 'R744',
        name: 'Carbon dioxide',
        tabName: 'CO₂ / carbon dioxide',
        alt: 'Buildings and processes with both heating and cooling demand',
        desc: 'CO₂ is ideal for buildings and processes that have both low-temperature cooling demand and high-temperature heat demand. The energy is used twice — from cooling to hot water.',
        gwpChip: 'GWP 1',
        stats: [
          { label: 'Capacity', val: '≤ 1000', unit: 'kW' },
          { label: 'Application', val: 'Dual', unit: 'use' },
          { label: 'GWP', val: '1' },
        ],
      },
      {
        id: 'r717',
        code: 'R717',
        name: 'Ammonia',
        tabName: 'NH₃ / ammonia',
        alt: 'Industrial refrigeration and heat pump systems',
        desc: 'When a project requires several thousand kilowatts — slaughterhouses, aquaculture or district heating at scale — ammonia is the most efficient choice. GWP of 0, with unmatched performance.',
        gwpChip: 'GWP 0',
        stats: [
          { label: 'Capacity', val: '> 300', unit: 'kW' },
          { label: 'Outgoing temp.', val: '80', unit: '°C' },
          { label: 'GWP', val: '0' },
        ],
      },
    ],
  },
};

const t = copy[lang];
---

<section id="refrigerants">
  <div class="inner">
    <div class="section-head reveal">
      <div class="section-num">{t.sectionNum}</div>
      <div>
        <h2 class="section-title">
          {t.title} <span class="muted">{t.mutedTitle}</span>
        </h2>
        <p class="ref-pfas">{t.pfas}</p>
      </div>
    </div>

    <div class="ref-layout">
      <div class="ref-tabs" id="refTabs" role="tablist" aria-label={t.tabAria}>
        {
          t.refrigerants.map((r, i) => (
            <button
              class={`ref-tab${i === 0 ? ' active' : ''}`}
              data-ref={r.id}
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`panel-${r.id}`}
              id={`tab-${r.id}`}
              type="button"
            >
              <span class="dot" />
              <span>
                <div class="code">{r.code}</div>
                <div class="name">{r.tabName}</div>
              </span>
              <span class="gwp-chip">{r.gwpChip}</span>
            </button>
          ))
        }
      </div>

      <div class="ref-content">
        <div class="ref-panels">
          {
            t.refrigerants.map((r, i) => (
              <div
                class={`ref-panel${i === 0 ? ' active' : ''}`}
                data-panel={r.id}
                id={`panel-${r.id}`}
                role="tabpanel"
                aria-labelledby={`tab-${r.id}`}
              >
                <div class="ref-head">
                  <div class="ref-code">{r.code}</div>
                  <div class="ref-name">{r.name}</div>
                </div>
                <div class="ref-alt">{r.alt}</div>
                <div class="ref-desc">{r.desc}</div>
                <div class="ref-stats">
                  {r.stats.map((s) => (
                    <div class="ref-stat">
                      <div class="label">{s.label}</div>
                      <div class="val">
                        {s.val}
                        {s.unit && <span class="unit">{s.unit}</span>}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
