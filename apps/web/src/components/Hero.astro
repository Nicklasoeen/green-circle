---
import type {Lang} from '../i18n';

interface Props {
  lang?: Lang;
}

const {lang = 'nb'} = Astro.props;

const copy = {
  nb: {
    eyebrow: 'Kulde- og varmepumpeaggregater',
    title: {
      line1: 'Naturlige',
      line2: 'kuldemedier.',
      lime: 'Håndlagd',
      green: 'ingeniørkunst.',
    },
    lead:
      'Green Circle er en serie skreddersydde kulde- og varmepumpeaggregater utviklet av bransjens mest dedikerte fagfolk — med naturlige kuldemedier, lavest mulig klimaavtrykk og en enestående energieffektivitet (COP).',
    primaryCta: 'Utforsk kuldemediene',
    secondaryCta: 'Les kundehistorien',
    imageAlt: 'Green Circle aggregat åpnet — viser interne komponenter',
    specs: [
      {
        num: '4',
        unit: 'medier',
        label: 'R290 · R600a · R744 · R717',
      },
      {
        num: '85',
        unit: '°C',
        label: 'Utgående varmtvann',
      },
      {
        num: '3–8×',
        unit: '',
        label: 'Varme per kWh tilført',
      },
    ],
  },
  en: {
    eyebrow: 'Refrigeration and heat pump units',
    title: {
      line1: 'Natural',
      line2: 'refrigerants.',
      lime: 'Handcrafted',
      green: 'engineering.',
    },
    lead:
      'Green Circle is a range of bespoke refrigeration and heat pump units produced by specialists in the field — using refrigerants with the lowest possible climate impact and outstanding COP.',
    primaryCta: 'Explore refrigerants',
    secondaryCta: 'Read the customer story',
    imageAlt: 'Open Green Circle unit showing internal components',
    specs: [
      {
        num: '4',
        unit: 'media',
        label: 'R290 · R600a · R744 · R717',
      },
      {
        num: '85',
        unit: '°C',
        label: 'Outgoing hot water',
      },
      {
        num: '3–8×',
        unit: '',
        label: 'Heat per kWh input',
      },
    ],
  },
}[lang];

const tags = [
  { code: 'R290', gwp: 'GWP 3', color: '#8BC53F', pos: 't1' },
  { code: 'R600a', gwp: 'GWP 3', color: '#6B8E6B', pos: 't2' },
  { code: 'R744', gwp: 'GWP 1', color: '#4F6F50', pos: 't3' },
  { code: 'R717', gwp: 'GWP 0', color: '#8BC53F', pos: 't4' },
];
---

<header class="hero" id="top">
  <div class="hero-grid">
    <div>
      <div class="eyebrow">
        <span class="eyebrow-dot"></span>{copy.eyebrow}
      </div>
      <h1 class="display">
        {copy.title.line1}<br />{copy.title.line2}<br />
        <span class="lime">{copy.title.lime}</span> <span class="green">{copy.title.green}</span>
      </h1>
      <p class="lead">{copy.lead}</p>
      <div class="hero-ctas">
        <a class="btn btn-primary" href="#refrigerants">
          {copy.primaryCta}
          <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M3 8h10m-4-4 4 4-4 4"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
        <a class="btn btn-ghost" href="#case">{copy.secondaryCta}</a>
      </div>
      <div class="hero-specs">
        {
          copy.specs.map((s) => (
            <div class="hero-spec">
              <div class="num">
                {s.num}
                <span class="unit">{s.unit}</span>
              </div>
              <div class="label">{s.label}</div>
            </div>
          ))
        }
      </div>
    </div>

    <div class="hero-visual" id="heroVisual" aria-hidden="true">
      <div class="ring r1"></div>
      <div class="ring r2"></div>
      <div class="ticks" id="ticks"></div>
      <div class="hero-img-wrap">
        <img
          src="/assets/img-open.jpg"
          alt={copy.imageAlt}
        />
        <div class="hero-img-overlay"></div>
      </div>
      {
        tags.map((t) => (
          <div class={`orbit-tag ${t.pos}`}>
            <span class="pill" style={`background:${t.color}`} />
            {t.code} <span class="gwp">{t.gwp}</span>
          </div>
        ))
      }
    </div>
  </div>
</header>
